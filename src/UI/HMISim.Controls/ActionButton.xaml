<UserControl x:Class="HMISim.Controls.ActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="56" d:DesignWidth="220">
    <!-- 按钮控件：动作模式（点动/置位/复位/切换/写数值）在工程里配置，
         按下/松开/点击事件转发给 ControlItemViewModel 执行写入，本控件只管呈现。 -->
    <Border x:Name="Frame" BorderBrush="#FFD0D4D8" BorderThickness="1" CornerRadius="6" Background="White">
        <Button x:Name="InnerButton" Margin="3" FontSize="15" FontWeight="SemiBold"
                Click="InnerButton_OnClick"
                PreviewMouseLeftButtonDown="InnerButton_OnPreviewDown"
                PreviewMouseLeftButtonUp="InnerButton_OnPreviewUp" />
    </Border>
</UserControl>
