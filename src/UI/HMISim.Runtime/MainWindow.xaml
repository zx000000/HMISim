<Window x:Class="HMISim.Runtime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:HMISim.Controls;assembly=HMISim.Controls"
        mc:Ignorable="d"
        Title="HMISim 运行端（阶段 0 最小壳）" Height="600" Width="520"
        Background="#FFF3F4F6">
    <DockPanel Margin="12">
        <!-- 顶部说明 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="HMISim 运行端" FontSize="18" FontWeight="Bold" Foreground="#FF1F2937" />
            <TextBlock Text="演示工程：内置 FINS 模拟器（127.0.0.1:9600）｜质量：绿=正常 琥珀=不稳定 红=通讯异常 灰=无数据"
                       FontSize="11" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 底部操作与状态区 -->
        <StackPanel DockPanel.Dock="Bottom">
            <Border BorderBrush="#FFD0D4D8" BorderThickness="1" CornerRadius="6" Background="White" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="设定值 (D200)：" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Text="{Binding SetpointInput, UpdateSourceTrigger=PropertyChanged}"
                                 Width="90" FontSize="13" Padding="4,2" Margin="6,0" />
                        <Button Content="写入" Command="{Binding WriteSetpointCommand}" Padding="14,3" FontSize="13" />
                        <Button Content="模拟拔线" Command="{Binding DisconnectCommand}" Padding="10,3" FontSize="13" Margin="16,0,0,0" />
                        <Button Content="恢复连接" Command="{Binding ReconnectCommand}" Padding="10,3" FontSize="13" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding MessageText}" FontSize="12" Foreground="#FF374151" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#FF6B7280" />
        </StackPanel>

        <!-- 点位列表：每行一个 ValueDisplay 控件，只绑定标题/显示值/质量码 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ValueDisplay Title="{Binding Title}"
                                               DisplayValue="{Binding DisplayValue}"
                                               Quality="{Binding Quality}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
