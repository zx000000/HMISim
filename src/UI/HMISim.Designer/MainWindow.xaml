<Window x:Class="HMISim.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HMISim.Designer.Views"
        mc:Ignorable="d"
        Title="HMISim 组态端（阶段 1）" Height="840" Width="1320"
        Background="#FFF3F4F6">
    <DockPanel>
        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8">
            <Button Content="新建" Click="NewButton_OnClick" Padding="14,4" />
            <Button Content="打开…" Click="OpenButton_OnClick" Padding="14,4" Margin="6,0,0,0" />
            <Button Content="保存" Click="SaveButton_OnClick" Padding="14,4" Margin="6,0,0,0" />
            <Button Content="预览运行" Click="PreviewButton_OnClick" Padding="14,4" Margin="16,0,0,0" />
            <TextBlock Text="工程名：" VerticalAlignment="Center" Margin="20,0,4,0" />
            <TextBox Text="{Binding Document.Name, UpdateSourceTrigger=PropertyChanged}" Width="160" Padding="4,2" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#FF6B7280" FontSize="12" />
        </StackPanel>

        <!-- 工具箱 -->
        <StackPanel DockPanel.Dock="Left" Width="132" Margin="10,0,0,10">
            <TextBlock Text="工具箱" FontWeight="Bold" Margin="0,0,0,6" />
            <Button Content="＋ 数值显示" Click="AddValueButton_OnClick" Padding="6,6" HorizontalContentAlignment="Left" />
            <Button Content="＋ 文本标签" Click="AddLabelButton_OnClick" Padding="6,6" Margin="0,6,0,0" HorizontalContentAlignment="Left" />
            <Button Content="删除选中" Click="DeleteButton_OnClick" Padding="6,6" Margin="0,16,0,0" HorizontalContentAlignment="Left" />
            <TextBlock Text="点位表" FontWeight="Bold" Margin="0,20,0,6" />
            <ListBox ItemsSource="{Binding PointIds}" Height="220" />
            <TextBlock Text="点位/设备的编辑在后续阶段提供；当前用样例点位表。" FontSize="11"
                       Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <!-- 属性面板 -->
        <StackPanel DockPanel.Dock="Right" Width="248" Margin="10,0,10,10">
            <TextBlock Text="属性" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="未选中控件（在画布上单击一个控件）" FontSize="11" Foreground="#FF6B7280" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="标题" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4,2" />
                <TextBlock Text="绑定点位" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox ItemsSource="{Binding PointIds}" SelectedItem="{Binding EditBindingPointId}"
                          Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4,2" IsEditable="False" />
                <TextBlock Text="X" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Text="{Binding EditX, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4,2" />
                <TextBlock Text="Y" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Text="{Binding EditY, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="4,2" />
                <TextBlock Text="宽度" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="0,4" Padding="4,2" />
                <TextBlock Text="高度" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1" Margin="0,4" Padding="4,2" />
                <Button Content="应用属性" Click="ApplyButton_OnClick" Grid.Row="6" Grid.Column="1"
                        Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock Text="画布上可直接拖动移动、拖右下角灰块缩放；改完属性点「应用属性」生效。"
                       FontSize="11" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <!-- 画布 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <views:EditorCanvas x:Name="Editor" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="6" />
        </ScrollViewer>
    </DockPanel>
</Window>
