<Window x:Class="HMISim.Designer.Views.PointsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="点位 / 设备编辑" Height="660" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F4F6">
    <DockPanel Margin="12">
        <!-- 底部：校验信息 + 确定/取消 -->
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Foreground="#FFB91C1C" FontSize="12" TextWrapping="Wrap"
                       MaxHeight="96" Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="取消" Click="CancelButton_OnClick" Padding="18,5" />
                <Button Content="确定" Click="OkButton_OnClick" Padding="18,5" Margin="8,0,0,0" IsDefault="True" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 设备 -->
                <GroupBox Header="设备" Padding="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="设备 Id" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="DeviceIdBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4,2" />
                            <TextBlock Text="驱动" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,4,0,4" />
                            <ComboBox x:Name="DriverBox" Grid.Row="0" Grid.Column="3" Margin="0,4" Padding="4,2"
                                      SelectionChanged="DriverBox_OnSelectionChanged" />
                            <CheckBox x:Name="SimulatorCheck" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                      Content="使用内置模拟器作数据源（离线调试；接真实 PLC 时取消勾选）"
                                      VerticalAlignment="Center" Margin="0,6,0,2" />
                        </Grid>
                        <TextBlock Text="通讯参数（由驱动声明自动生成）" FontWeight="Bold" Margin="0,8,0,4" />
                        <StackPanel x:Name="ParamRows" />
                    </StackPanel>
                </GroupBox>

                <!-- 点位表 -->
                <GroupBox Header="点位表" Padding="8" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="＋ 添加点位" Click="AddPointButton_OnClick" Padding="10,4" />
                            <Button Content="删除选中" Click="DeletePointButton_OnClick" Padding="10,4" Margin="8,0,0,0" />
                            <TextBlock Text="名称即点位 Id，画面绑定按名称引用；改名后绑定自动跟随，删点位会清掉指向它的绑定。"
                                       FontSize="11" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" Height="252"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Id}" Width="150" />
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="130" />
                                <DataGridComboBoxColumn Header="数据类型" SelectedItemBinding="{Binding DataType}" Width="110" />
                                <DataGridTextColumn Header="周期 (ms)" Binding="{Binding ScanPeriodMs}" Width="90" />
                                <DataGridTextColumn Header="字数（字符串）" Binding="{Binding LengthWords}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
